# Copy this file to .env for local use. Never commit .env.
# On Cloudflare Pages, set the same names under:
#   Workers & Pages > your project > Settings > Variables and Secrets

# The ONE production URL used for canonicals, sitemap.xml, robots.txt,
# social tags and structured data. No trailing slash.
#   First launch:   https://YOUR-PROJECT.pages.dev
#   Custom domain:  https://dailybetterjourney.com
SITE_URL=http://localhost:4321

# Set to "true" on the Cloudflare PRODUCTION environment when you are ready
# to go public. The build then FAILS if your author details, contact email,
# privacy-policy fields or AdSense consent confirmation are incomplete, or if
# a published article still contains TODO text.
STRICT_LAUNCH=false

# Local dev only: set to "true" to preview draft articles in `npm run dev`.
# Drafts are never included in a production build.
PUBLIC_PREVIEW_DRAFTS=false
