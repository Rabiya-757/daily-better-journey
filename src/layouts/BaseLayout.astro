---
// The ONE shared layout. Every page, including the optional AdSense tags,
// is rendered through here.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, adsense, absoluteUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/about/". Used for the canonical and og:url. */
  path?: string;
  /** true = use `title` as-is instead of "title | Site name" */
  fullTitle?: boolean;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  /** noindex pages get no canonical and are not in the sitemap. */
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  publishedTime?: string;
  modifiedTime?: string;
  category?: string;
  /** Ads load only where this is true AND adsense.loadAdScript is on. Article pages only. */
  showAds?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  fullTitle = false,
  type = 'website',
  image,
  imageAlt,
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  category,
  showAds = false,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${site.siteName}`;
const canonical = absoluteUrl(path);
const shareImage = image ?? site.socialImage;
const shareImageUrl = shareImage ? absoluteUrl(shareImage) : undefined;
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    {shareImageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && category && <meta property="article:section" content={category} />}

    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
    {site.twitterHandle && <meta name="twitter:site" content={site.twitterHandle} />}

    {site.searchConsoleVerification && <meta name="google-site-verification" content={site.searchConsoleVerification} />}

    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}

    <!-- Google AdSense (disabled by default; see site.config.mjs and docs/ADSENSE-CHECKLIST.md) -->
    {adsense.verificationMeta && <meta name="google-adsense-account" content={adsense.publisherId} />}
    {
      showAds && adsense.loadScript && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.publisherId}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
