---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { site } from '../../lib/site';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const empty = posts.length === 0;
---

<BaseLayout
  title="Blog"
  description={`All ${site.siteName} articles on productivity, focus, motivation and building consistent habits, newest first.`}
  path="/blog/"
  noindex={empty}
>
  <div class="wrap page">
    <h1>Blog</h1>
    <p class="lead">Articles on productivity, focus, motivation and building consistent habits, newest first.</p>
    {empty ? <p class="empty">No articles have been published yet.</p> : <PostList posts={posts} level={2} />}
  </div>
</BaseLayout>
