---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." path="/404/" noindex>
  <div class="wrap page">
    <h1>Page not found</h1>
    <p class="lead">That address doesn’t lead anywhere. It may have moved, or the link may be mistyped.</p>
    <p><a href="/">Go to the home page</a> or <a href="/blog/">browse all articles</a>.</p>
  </div>
</BaseLayout>
