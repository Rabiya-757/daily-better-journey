---
import type { Article } from '../lib/posts';
import { postPath } from '../lib/posts';

interface Props {
  posts: Article[];
  /** true = chosen by your `related:` list, category or tags. false = just the latest articles. */
  matched: boolean;
}
const { posts, matched } = Astro.props;
---

{
  posts.length > 0 && (
    <aside class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">{matched ? 'Related articles' : 'More articles'}</h2>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={postPath(post)}>{post.data.title}</a>
            <span class="related-category">{post.data.category}</span>
          </li>
        ))}
      </ul>
    </aside>
  )
}
